{
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/skills/mcomix-loop/state"
    ],
    "allow": [
      "Bash(gh issue close * --repo twwn/mcomix *)"
    ],
    "deny": [
      "Edit(~/.config/mcomix/**)",
      "Edit(~/.local/share/mcomix/**)",
      "Edit(~/.local/share/recently-used.xbel)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "d=$HOME/.claude/skills/mcomix-loop; [ -d \"$d/scripts\" ] || d=$CLAUDE_PROJECT_DIR/.claude/skills/mcomix-loop; [ -x \"$d/scripts/subagent-guard.sh\" ] || exit 0; exec \"$d/scripts/subagent-guard.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
